---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageMetadata from '../components/PageMetadata.astro';

interface Props {
	title: string;
	description?: string;
	breadcrumb?: string;
	excerpt?: string;
	categories?: string[];
	tags?: string[];
	page_links?: Record<string, string>;
	date?: string | Date;
	sidebar?: boolean | string;
	include_bootstrap?: boolean;
	crumb?: string;
}

const {
	title,
	breadcrumb,
	excerpt,
	description = excerpt ?? title,
	categories = [],
	tags = [],
	page_links: pageLinks = {},
	date,
	sidebar,
	include_bootstrap: includeBootstrap,
	crumb,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<PageMetadata
				breadcrumb={breadcrumb}
				categories={categories}
				tags={tags}
				links={pageLinks}
			/>
			<slot />
		</main>
		<Footer />
	</body>
</html>