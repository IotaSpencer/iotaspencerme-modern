---
import Page from '../layouts/Page.astro';
import { Accordion } from 'webcoreui/astro';

const page = {
    title: 'Coding Activity',
    categories: ['Wakatime'],
    tags: ['wakatime', 'coding', 'activity', 'coding activity'],
    sidebar: false,
    breadcrumb: 'Wakatime Activity',
};

const activityItems = [
    {
        title: 'Language Activity',
        expanded: true,
        content: `<figure><embed src="https://wakatime.com/share/@IotaSpencer/02c2b5c0-4307-40e8-bd7c-ea67baf98089.svg" style="height:auto;width:100%;"></figure>`,
    },
    {
        title: 'Coding Activity',
        content: `<figure><embed src="https://wakatime.com/share/@IotaSpencer/47ad3b46-6e9b-448e-930e-f66a721ea5f8.svg" style="height:auto;width:100%;"></figure>`,
    },
    {
        title: 'Editor Activity',
        content: `<figure><embed src="https://wakatime.com/share/@IotaSpencer/0997a385-a66a-4f25-ad14-2c5ded419a4a.svg" style="height:auto;width:100%;"></figure>`,
    },
    
];
---

<Page {...page}>
    <h1>Coding Activity</h1>
    <Accordion items={activityItems} icon="plus" />

</Page>