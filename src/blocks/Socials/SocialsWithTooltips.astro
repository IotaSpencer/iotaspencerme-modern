---
import { Icon } from 'webcoreui/astro'

import { iconMap } from './iconMap'
import type { SocialsWithTooltipsProps } from './socialsWithTooltips'
import styles from './socials.module.scss'

export type Props = SocialsWithTooltipsProps

const {
    links,
    size,
    color,
    theme,
    className,
    tooltips = false
} = Astro.props

const classes = [
    styles.socials,
    className
]

const getDomain = (str: string) => {
    try {
        return new URL(str).hostname
            .replace('www.', '')
            .replace('twitter', 'x')
            .split('.')[0]
    } catch {
        return 'website'
    }
}

const getTooltip = (link: string) => {
    const domain = getDomain(link)
    return domain === 'x' ? 'X' : domain.charAt(0).toUpperCase() + domain.slice(1)
}

const getTooltipText = (link: string) => {
    if (typeof tooltips === 'object') {
        return tooltips[link] ?? getTooltip(link)
    }

    return getTooltip(link)
}
---

{links?.length && (
    <ul class:list={classes}>
        {links.map(link => (
            <li>
                <a
                    href={link}
                    target="_blank"
                    rel="noreferrer"
                    data-tooltip={tooltips ? getTooltipText(link) : undefined}
                    aria-label={tooltips ? getTooltipText(link) : undefined}
                >
                    <Icon
                        iconSet={iconMap}
                        size={size}
                        color={color}
                        theme={theme}
                        type={iconMap[getDomain(link) as keyof typeof iconMap]
                            ? getDomain(link)
                            : 'website'
                        }
                    />
                </a>
            </li>
        ))}
    </ul>
)}
