---
interface Props {
	breadcrumb?: string;
	categories: string[];
	tags: string[];
	links: Record<string, string>;
}

const { breadcrumb, categories, tags, links } = Astro.props;
const hasMetadata = Boolean(
	breadcrumb || categories.length > 0 || tags.length > 0 || Object.keys(links).length > 0,
);
---

{hasMetadata && (
	<nav aria-label="Page metadata" class="page-metadata">
		{breadcrumb && <span class="breadcrumb">{breadcrumb}</span>}
		{categories.length > 0 && (
			<div class="metadata-group">
				<span class="metadata-label">Filed under</span>
				<ul aria-label="Categories">
				{categories.map((category) => <li>{category}</li>)}
				</ul>
			</div>
		)}
		{tags.length > 0 && (
			<div class="metadata-group">
				<span class="metadata-label">Tagged</span>
				<ul aria-label="Tags">
				{tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>
		)}
		{Object.entries(links).length > 0 && (
			<div class="metadata-group">
				<span class="metadata-label">Explore</span>
				<ul aria-label="Related links">
				{Object.entries(links).map(([label, href]) => (
					<li><a href={href}>{label}</a></li>
				))}
				</ul>
			</div>
		)}
	</nav>
)}

<style>
	.page-metadata {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.25rem;
		align-items: center;
		margin: -1.5rem auto 1.5rem;
		padding: 0.8rem 0;
		max-width: 720px;
		border-top: 1px solid rgb(var(--gray-light));
		border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 0.78rem;
		line-height: 1.4;
		color: rgb(var(--gray));
	}
	.breadcrumb,
	.metadata-group {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
	}
	.breadcrumb {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.metadata-label {
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--accent);
	}
	.page-metadata ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.page-metadata li {
		position: relative;
	}
	.page-metadata li:not(:last-child)::after {
		content: '/';
		position: absolute;
		right: -0.45rem;
		color: rgb(var(--gray-light));
	}
	.page-metadata a {
		font-weight: 700;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}
	@media (max-width: 720px) {
		.page-metadata {
			margin-top: -0.5rem;
		}
	}
	}
</style>