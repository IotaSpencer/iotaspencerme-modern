---
import HeaderLink from './HeaderLink.astro';
import  NavBar from './NavBar.astro';
import { SITE_TITLE } from '../consts';
import SocialsWithTooltips from '@blocks/Socials/SocialsWithTooltips.astro';

const socialLinks = [
	'https://github.com/IotaSpencer',
	'https://github.com/ElectroCode',
	'https://discord.gg/ethbbzPnEV',
];

const socialTooltips = {
	'https://github.com/IotaSpencer': 'My GitHub Profile',
	'https://github.com/ElectroCode': 'ElectroCode on GitHub',
	'https://discord.gg/ethbbzPnEV': 'Join my Developer Discord',
	'https://community.steampowered.com/id/IotaSpencer': 'My Steam Profile',
	'https://www.twitch.tv/iotaspencer': 'My Twitch Channel',
	'https://www.youtube.com/@IotaSpencer': 'My YouTube Channel',
	'https://www.youtube.com/@IotaPlays': 'IotaPlays YouTube Channel',
	'https://www.xbox.com/en-us/play/user/IotaSpencer': 'My Xbox Profile',
	'https://cash.app/$IotaSpencer': 'My Cash App'
};
---

<header>
	<nav>
		<a href="/"><img src="/iota.png" alt="Logo" style="width: 100px; height: auto;" /></a>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="flex-grow-2"></div>
		<SocialsWithTooltips 
			links={socialLinks}
			tooltips={socialTooltips}
			color="#a9a9a9"
		/>
		<NavBar />
		
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--color-bg);
		color: var(--color-text);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		background: var(--color-bg);
		color: var(--color-text);
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		background: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
	}
	nav {
		background: var(--color-bg);
		color: var(--color-text);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		background: var(--color-bg);
		color: var(--color-text);
		border-bottom: 4px solid transparent;
		overflow-wrap: normal;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		background: var(--color-bg);
		color: var(--color-text);
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
