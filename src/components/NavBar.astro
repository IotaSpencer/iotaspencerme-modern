---
import ChevronDownIcon from '~icons/akar-icons/chevron-down';
---

<div class="nav-rail">
  <button
    id="nav-offcanvas-toggle"
    type="button"
    class="nav-toggle"
    aria-expanded="false"
    aria-controls="nav-offcanvas-panel"
  >
    <span class="nav-toggle-label">Menu</span>
    <ChevronDownIcon class="nav-toggle-icon" />
  </button>

  <div
    id="nav-offcanvas-backdrop"
    class="nav-backdrop"
    aria-hidden="true"
  ></div>

  <aside
    id="nav-offcanvas-panel"
    class="nav-panel"
    aria-hidden="true"
  >
    <div class="nav-panel-header">
      <h2>Navigation</h2>
      <button id="nav-offcanvas-close" type="button" class="nav-close-button" aria-label="Close menu">
        Close
      </button>
    </div>

    <div class="nav-panel-section">
      <p class="nav-panel-label">Explore</p>
      <nav class="nav-panel-links" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
      </nav>
    </div>

    <div class="nav-panel-section">
      <p class="nav-panel-label">More</p>
      <nav class="nav-panel-links" aria-label="Secondary navigation">
        <a href="/projects">Projects</a>
        <a href="/activity">Wakatime Activity</a>
      </nav>
    </div>
  </aside>
</div>

<style>
  .nav-rail {
    position: relative;
    display: inline-flex;
    align-items: center;
    z-index: 1;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(var(--gray), 0.25);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 999px;
    padding: 0.6rem 1rem;
    font: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .nav-toggle:hover {
    border-color: rgba(var(--gray), 0.45);
    box-shadow: 0 2px 10px rgba(var(--gray), 0.08);
  }

  .nav-toggle-label {
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .nav-toggle-icon {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.2s ease;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 40;
  }

  .nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: min(22rem, 90vw);
    height: 100vh;
    background: var(--color-bg);
    color: var(--color-text);
    border-left: 1px solid rgba(var(--gray), 0.18);
    box-shadow: -12px 0 30px rgba(var(--black), 0.12);
    padding: 1.5rem 1.25rem;
    transform: translateX(100%);
    transition: transform 0.28s ease;
    z-index: 50;
  }

  .nav-panel.is-open {
    transform: translateX(0);
  }

  .nav-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(var(--gray), 0.12);
  }

  .nav-panel-header h2 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .nav-close-button {
    background: transparent;
    border: 1px solid rgba(var(--gray), 0.18);
    border-radius: 999px;
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    opacity: 1;
  }

  .nav-panel-section {
    margin-bottom: 1.5rem;
  }

  .nav-panel-label {
    margin: 0 0 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--gray-dark), 0.72);
  }

  .nav-panel-links {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-panel-links a {
    display: block;
    padding: 0.8rem 0.75rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: 0.75rem;
    background: transparent;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .nav-panel-links a:hover {
    color: var(--accent);
    background: rgba(var(--gray-light), 0.4);
    border-color: rgba(var(--gray), 0.12);
  }
</style>

<script>
  const toggleButton = document.getElementById('nav-offcanvas-toggle');
  const closeButton = document.getElementById('nav-offcanvas-close');
  const backdrop = document.getElementById('nav-offcanvas-backdrop');
  const panel = document.getElementById('nav-offcanvas-panel');
  const icon = toggleButton?.querySelector('svg');

  function setOffcanvasOpen(isOpen) {
    if (!toggleButton || !panel || !backdrop) return;

    toggleButton.setAttribute('aria-expanded', String(isOpen));
    panel.classList.toggle('is-open', isOpen);
    panel.setAttribute('aria-hidden', String(!isOpen));
    backdrop.classList.toggle('is-open', isOpen);
    backdrop.setAttribute('aria-hidden', String(!isOpen));

    if (icon) {
      icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  toggleButton?.addEventListener('click', () => {
    const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
    setOffcanvasOpen(!isOpen);
  });

  closeButton?.addEventListener('click', () => setOffcanvasOpen(false));
  backdrop?.addEventListener('click', () => setOffcanvasOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setOffcanvasOpen(false);
    }
  });
</script>