---
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems, DropdownSubmenu } from "astro-navbar";
import ChevronDownIcon from '~icons/akar-icons/chevron-down';



---

<div>
  <Astronav>
    <div class="flex justify-between justify-items-center">
        <MenuIcon class="w-8 h-8 text-gray-800 m-auto" />
    </div>
    <MenuItems class="hidden ">
      <ul class="">
        <a href="/" class="pr-2"><li style="display: inline-block;">Home</li></a>&nbsp;&sol;&nbsp;
        <a href="/about" class="pr-2"><li style="display: inline-block;">About</li></a>&nbsp;&sol;&nbsp;
        <a href="/blog" class="pr-2"><li style="display: inline-block;">Blog</li></a>&nbsp;&sol;&nbsp;
        <li class="relative inline-block">
          <Dropdown class="group relative">
            <button class="flex items-center gap-1">
              <span> Placeholder </span>
              <ChevronDownIcon class="w-6 h-6 text-gray-800 group-open:rotate-180 transition-transform" style="display: block;" />
            </button>
            <DropdownItems class="relative">
              <div class="absolute left-0 top-full z-50 mt-2 min-w-44 rounded-md border border-gray-200 bg-white p-2 shadow-lg">
                <ul class="m-0 list-none space-y-1">
                  <li class="px-2 py-1">Menu 1</li>
                  <li class="px-2 py-1">Menu 2</li>
                  <li class="relative px-2 py-1">
                    <DropdownSubmenu class="group/submenu relative">
                      <button class="flex items-center justify-between gap-2">Submenu</button>
                      <DropdownItems class="relative">
                        <div class="absolute left-full top-0 z-50 ml-2 min-w-40 rounded-md border border-gray-200 bg-white p-2 shadow-lg">
                          <ul class="m-0 list-none space-y-1">
                            <li class="px-2 py-1">Sub Menu 1</li>
                            <li class="px-2 py-1">Sub Menu 2</li>
                          </ul>
                        </div>
                      </DropdownItems>
                    </DropdownSubmenu>
                  </li>
                </ul>
              </div>
            </DropdownItems>
          </Dropdown>
        </li>
      </ul>
    </MenuItems>
  </Astronav>
</div>