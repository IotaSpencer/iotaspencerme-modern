---
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems, DropdownSubmenu } from "astro-navbar";
import ChevronDownIcon from '~icons/akar-icons/chevron-down';



---

<div>
  <Astronav>
    <div class="flex justify-between">
      <a><img src="/iota.png" alt="Logo" style="width: 100px; height: auto;" /></a>
      <div class="my-auto">
        <MenuIcon class="w-4 h-4 text-gray-800 m-auto" />
      </div>
    </div>
    <MenuItems class="hidden ">
      <ul class="">
        <a href="/" class="pr-2"><li style="display: inline-block;">Home</li></a>
        <a href="/about" class="pr-2"><li style="display: inline-block;">About</li></a>
        <li>
          <Dropdown class="group">
            <button>
              <span> Services </span>
              <!-- You can style when dropdown is `open` -->
              <ChevronDownIcon class="w-4 h-4 text-gray-800 group-open:rotate-180 transition-transform" />
            </button>
            <DropdownItems>
              <div class="absolute top-0">
                <ul>
                  <li>Menu 1</li>
                  <li>Menu 2</li>
                  <li>
                    <DropdownSubmenu>
                      <button>Submenu</button>
                      <DropdownItems>
                        <ul>
                          <li>Sub Menu 1</li>
                          <li>Sub Menu 2</li>
                        </ul>
                      </DropdownItems>
                    </DropdownSubmenu>
                  </li>
                </ul>
              </div>
            </DropdownItems>
          </Dropdown>
        </li>
      </ul>
    </MenuItems>
  </Astronav>
</div>