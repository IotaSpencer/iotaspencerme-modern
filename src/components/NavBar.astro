---
import ChevronDownIcon from '~icons/akar-icons/chevron-down';
---

<div class="relative">
  <button
    id="nav-offcanvas-toggle"
    type="button"
    class="flex items-center gap-1 rounded-md px-2 py-1 text-left"
    aria-expanded="false"
    aria-controls="nav-offcanvas-panel"
  >
    <span>Menu</span>
    <ChevronDownIcon class="h-6 w-6 text-gray-800 transition-transform duration-200" />
  </button>

  <div
    id="nav-offcanvas-backdrop"
    class="pointer-events-none fixed inset-0 z-40 bg-black/30 opacity-0 transition-opacity duration-200"
  ></div>

  <aside
    id="nav-offcanvas-panel"
    class="fixed right-0 top-0 z-50 h-screen w-[min(22rem,90vw)] translate-x-full border-l border-gray-200 bg-white p-6 shadow-2xl transition-transform duration-300 ease-out"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between">
      <h2 class="m-0 text-xl font-bold text-gray-900">Menu</h2>
      <button id="nav-offcanvas-close" type="button" class="text-lg font-medium text-gray-600">
        Close
      </button>
    </div>

    <ul class="mt-6 space-y-4 text-left text-base text-gray-800">
      <li><a href="/" class="block py-2">Home</a></li>
      <li><a href="/about" class="block py-2">About</a></li>
      <li><a href="/blog" class="block py-2">Blog</a></li>
      <li><a href="/" class="block py-2">Menu 1</a></li>
      <li><a href="/about" class="block py-2">Menu 2</a></li>
    </ul>
  </aside>
</div>

<script>
  const toggleButton = document.getElementById('nav-offcanvas-toggle');
  const closeButton = document.getElementById('nav-offcanvas-close');
  const backdrop = document.getElementById('nav-offcanvas-backdrop');
  const panel = document.getElementById('nav-offcanvas-panel');

  function setOffcanvasOpen(isOpen: boolean | undefined) {
    if (!toggleButton || !panel || !backdrop) return;

    toggleButton.setAttribute('aria-expanded', String(isOpen));
    panel.classList.toggle('translate-x-full', !isOpen);
    panel.classList.toggle('translate-x-0', Boolean(isOpen));
    panel.setAttribute('aria-hidden', String(!isOpen));

    backdrop.classList.toggle('opacity-0', !isOpen);
    backdrop.classList.toggle('pointer-events-none', !isOpen);
    backdrop.classList.toggle('opacity-100', Boolean(isOpen));
    backdrop.classList.toggle('pointer-events-auto', Boolean(isOpen));

    const icon = toggleButton.querySelector('svg');
    if (icon) {
      icon.classList.toggle('rotate-180', Boolean(isOpen));
    }
  }

  toggleButton?.addEventListener('click', () => {
    const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
    setOffcanvasOpen(!isOpen);
  });

  closeButton?.addEventListener('click', () => setOffcanvasOpen(false));
  backdrop?.addEventListener('click', () => setOffcanvasOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setOffcanvasOpen(false);
    }
  });
</script>